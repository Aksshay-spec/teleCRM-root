{
  "compilerOptions": {
    "target": "ES2023",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,

    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "paths": {
      "@/*": ["./*"]
    }
  }
}
