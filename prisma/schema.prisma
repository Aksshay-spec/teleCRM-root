datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccessLevel {
  L1
  L2
  L3
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ProcessType {
  LEAD
  TICKET
  CALL
  TRANSFER
  FOLLOW_UP
}

enum FormFieldType {
  TEXT
  NUMBER
  BOOLEAN
  DATE
  DROPDOWN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model FormDefinition {
  id              String       @id @default(uuid())

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  processType     ProcessType  // 🔒 LEAD / TICKET / CALL etc.
  name            String       // e.g. "Website Lead Form"
  description     String?

  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  fields          FormFieldDefinition[]

  @@index([organizationId, processType])
}

model FormFieldDefinition {
  id              String         @id @default(uuid())

  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])

  formId          String
  form            FormDefinition @relation(fields: [formId], references: [id])

  key             String         // e.g. "business_name"
  label           String         // "Business Name"
  type            FormFieldType
  required        Boolean        @default(false)

  options         Json?          // for DROPDOWN
  order           Int

  isSystem        Boolean        @default(false) // 🔒 system fields marker

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([formId, key])
  @@index([organizationId])
}

model Lead {
  id               String          @id @default(uuid())

  // 🔒 Tenant isolation
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])

  // 🔒 System-mandatory fields
  name             String
  phone            String

  // 🔓 Dynamic data
  data             Json?

  // 🔒 Audit
  createdByUserId  String
  createdByUser    User @relation("LeadCreatedBy", fields: [createdByUserId], references: [id])
  createdByRole    AccessLevel

  // 🔒 Approval
  approvalStatus   ApprovalStatus

  approvedByUserId String?
  approvedByUser   User? @relation("LeadApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId])
  @@index([phone])
  @@index([approvalStatus])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  status    Status   @default(ACTIVE)

  users       User[]
  teams       Team[]
  departments Department[]

    // 🔽 NEW BACK RELATIONS
  formDefinitions      FormDefinition[]
  formFieldDefinitions FormFieldDefinition[]
  leads                Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name]) // no duplicate dept names per org
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  designation  String
  accessLevel  AccessLevel
  status       Status      @default(ACTIVE)
  isSuperAdmin Boolean     @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  teamId      String?
  team        Team?       @relation("TeamMembers", fields: [teamId], references: [id])

  managedTeam Team?       @relation("TeamManager")

    // 🔽 NEW BACK RELATIONS
  createdLeads   Lead[] @relation("LeadCreatedBy")
  approvedLeads  Lead[] @relation("LeadApprovedBy")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Team {
  id             String   @id @default(uuid())
  name           String

  organizationId String
  managerId      String  @unique

  organization Organization @relation(fields: [organizationId], references: [id])
  manager      User         @relation("TeamManager", fields: [managerId], references: [id])
  members      User[]       @relation("TeamMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
